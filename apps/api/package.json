{
  "name": "@goease/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently --raw -k -n compiler,server \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/src/main.js --dev-watch\"",
    "start": "node dist/src/main.js",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy --config prisma7.config.ts",
    "db:seed": "node --env-file-if-exists=.env.local dist/src/database/seed.js",
    "db:local": "node dist/scripts/db-local.js",
    "db:check": "pnpm build && node --test dist/test/database.test.js"
  },
  "dependencies": {
    "@goease/contracts": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "google-auth-library": "11.2.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
