{
  "name": "@goease/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently -k -n types,api \"tsc --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "node scripts/clean-build.mjs dist && prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demos.json --noEmit",
    "lint": "eslint src dev tests tests-db scripts prisma.config.ts",
    "test": "pnpm build && pnpm build:demos && node --test tests/*.test.mjs",
    "test:gemini:live": "node --env-file-if-exists=.env scripts/gemini-live.mjs",
    "demo": "pnpm build:demos && node --env-file-if-exists=.env dist-demos/dev/demos/ai/main.js",
    "demo:auth": "pnpm build:demos && node --env-file-if-exists=.env dist-demos/dev/demos/auth/main.js",
    "demo:trips": "pnpm build:demos && node --env-file-if-exists=.env dist-demos/dev/demos/trips/main.js",
    "build:demos": "node scripts/clean-build.mjs dist-demos && tsc -p tsconfig.demos.json",
    "format": "prettier --write \"src/**/*.ts\" \"dev/**/*.ts\" \"tests/**/*.mjs\" \"tests-db/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"dev/**/*.ts\" \"tests/**/*.mjs\" \"tests-db/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\" \".prettierrc.json\""
  },
  "dependencies": {
    "@goease/catalog": "workspace:*",
    "@goease/contracts": "workspace:*",
    "@goease/itinerary": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "concurrently": "10.0.6",
    "eslint": "^9.39.5",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
