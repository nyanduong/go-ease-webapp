{
  "name": "@goease/api", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently -k -n types,api \"tsc --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@goease/catalog": "workspace:*", "@goease/contracts": "workspace:*",
    "@nestjs/common": "12.1.3", "@nestjs/core": "12.1.3", "@nestjs/platform-express": "12.1.3",
    "reflect-metadata": "0.2.2", "rxjs": "7.8.2", "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6", "@types/node": "^24.0.0", "concurrently": "10.0.6",
    "typescript": "~6.0.3", "eslint": "^9.39.5", "typescript-eslint": "^8.71.2"
  }
}
