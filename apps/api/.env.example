NODE_ENV=development
PORT=3000
HOST=127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL: runtime role riêng, cấp qua environment/private .env.local.
# DATABASE_MIGRATION_URL: operator role riêng, chỉ migrate/seed; không dùng cho API.
# pnpm --filter @goease/api db:local init tạo giá trị local an toàn; không commit/in URL.
# GOEASE_LOCAL_STATE_DIR: fresh task under %LOCALAPPDATA%\GoEase\local-db; use returned physical path.
# GOEASE_NATIVE_TRIAL_EMAILS: optional backend-only verified-email allowlist, never set empty.
# Trial setup/bounds/private ACL preflight: docs/verification/NATIVE_TRIAL_SECURITY.md.
