# Local API; use 0.0.0.0 explicitly to allow a phone on the same LAN.
API_HOST=127.0.0.1
API_PORT=3000
API_REQUEST_TIMEOUT_MS=5000
API_RECEIVE_TIMEOUT_MS=15000
# Exact browser origins, comma separated. Native Expo Go sends no Origin.
API_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4174,http://localhost:4174
# Auth spike #75, off until an authorized Supabase project and native proof exist.
AUTH_ENABLED=false
# Product PWA/admin require Google OAuth. false is only for legacy Expo/test environments.
AUTH_GOOGLE_ONLY=true
SUPABASE_AUTH_URL=
# Public publishable key only (not sb_secret/service_role, password or JWT signing key).
SUPABASE_PUBLISHABLE_KEY=
AUTH_TIMEOUT_MS=3000
# #76: dedicated private local PostgreSQL only; pnpm db:local writes runtime URL.
# Keep migration/admin credentials outside this file. Requires AUTH_ENABLED=true.
TRIPS_ENABLED=false
CATALOG_ADMIN_ENABLED=false
DATABASE_URL=
TRIPS_DB_TIMEOUT_MS=3000
# Destination discovery: provider key is backend-only. One search per uncached action,
# never auto-retry. Set API_REQUEST_TIMEOUT_MS >= AUTH_TIMEOUT_MS + SERPAPI_TIMEOUT_MS + 500.
SERPAPI_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_MS=3000
SERPAPI_MAX_ATTEMPTS_PER_MINUTE=4
SERPAPI_MAX_ATTEMPTS_PER_USER_DAY=10
SERPAPI_MAX_ATTEMPTS_PER_DAY=40
SERPAPI_MAX_TOTAL_ATTEMPTS=100
SERPAPI_CACHE_TTL_MS=21600000
# Persistent single-process cost guard. Do not delete/reset it to regain quota.
SERPAPI_STATE_DIR=.discovery-runtime
# Optional aggregate diagnostics only: city ID, request count, cache hit, latency, place count.
SERPAPI_LOG_METRICS=false
# With trips enabled set API_REQUEST_TIMEOUT_MS >= AUTH_TIMEOUT_MS + TRIPS_DB_TIMEOUT_MS + 500.
# Gemini #72 is off by default. No live test until key/quota and ONE call are authorized.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Backend-to-backend/operator bearer credential, 32-128 random URL-safe chars.
# Never put this or the provider key in mobile/EXPO_PUBLIC_*.
AI_ACCESS_TOKEN=
GEMINI_TIMEOUT_MS=4000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_ATTEMPTS_PER_MINUTE=2
GEMINI_MAX_ATTEMPTS_PER_DAY=5
GEMINI_MAX_TOTAL_ATTEMPTS=10
# Private persistent local directory, one API process; do not reset to regain quota.
GEMINI_STATE_DIR=.ai-runtime
