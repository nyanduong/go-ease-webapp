# Local API; use 0.0.0.0 explicitly to allow a phone on the same LAN.
API_HOST=127.0.0.1
API_PORT=3000
API_REQUEST_TIMEOUT_MS=5000
API_RECEIVE_TIMEOUT_MS=15000
# Exact browser origins, comma separated. Native Expo Go sends no Origin.
API_CORS_ORIGINS=http://localhost:8081
# Gemini #72 is off by default. No live test until key/quota and ONE call are authorized.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Backend-to-backend/operator bearer credential, 32-128 random URL-safe chars.
# Never put this or the provider key in mobile/EXPO_PUBLIC_*.
AI_ACCESS_TOKEN=
GEMINI_TIMEOUT_MS=4000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_ATTEMPTS_PER_MINUTE=2
GEMINI_MAX_ATTEMPTS_PER_DAY=5
GEMINI_MAX_TOTAL_ATTEMPTS=10
# Private persistent local directory, one API process; do not reset to regain quota.
GEMINI_STATE_DIR=.ai-runtime
