{
  "name": "@goease/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts",
    "test": "tsc -p tsconfig.logic-tests.json && node --test tests/service-worker.test.mjs tests/trip-edit.test.mjs tests/google-auth.test.mjs tests/account-profile.test.mjs tests/token-session.test.mjs tests/discovery-client.test.mjs tests/confirmation-service.test.mjs tests/local-api-origin.test.mjs tests/offline-trips.test.mjs tests/m0-web.test.mjs",
    "test:offline": "node --test tests/offline-trips.test.mjs tests/offline-production.test.mjs",
    "test:e2e": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "@goease/catalog": "workspace:*",
    "@goease/contracts": "workspace:*",
    "@goease/itinerary": "workspace:*",
    "@goease/trip-client": "workspace:*",
    "@goease/trip-storage": "workspace:*",
    "leaflet": "1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/google.maps": "3.58.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4"
  }
}
