# Public browser settings only. Never put a Gemini key, JWT, password or service role here.
# Guest trips work without a backend. Account trips require an exact HTTPS API origin.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Browser-restricted Google Maps key, Maps JavaScript API enabled; optional for guest CRUD.
VITE_GOOGLE_MAPS_API_KEY=
# Internal AI demo only, opt-in. Enter its temporary session code in the UI, never in env.
VITE_AI_DEMO_ENABLED=false
VITE_AI_API_BASE_URL=
