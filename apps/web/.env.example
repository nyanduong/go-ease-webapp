# Public browser settings only. Never put a Gemini key, JWT, password or service role here.
# Google login + verified backend are mandatory. Exact HTTPS API origin or HTTP loopback for same-machine dev; see docs/GOOGLE_LOGIN.md.
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# pnpm dev:offline enables VITE_DEV_OFFLINE=true for Vite dev only (never production).
# Public browser/referrer-restricted key with Maps JavaScript API enabled (optional).
VITE_GOOGLE_MAPS_API_KEY=
# Optional public original Cloudinary delivery URL (no transformations or credentials).
VITE_CLOUDINARY_DALAT_URL=
# Optional overrides for the two generated login postcards.
VITE_CLOUDINARY_LOGIN_LAKE_URL=
VITE_CLOUDINARY_LOGIN_LANE_URL=
