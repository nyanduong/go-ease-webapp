  "cli": { "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "GOEASE_APP_VARIANT": "development" }, "android": { "buildType": "apk" } },
    "development-simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": { "developmentClient": false, "distribution": "internal", "env": { "GOEASE_APP_VARIANT": "preview" }, "android": { "buildType": "apk" } }
  }
}
