{
  "name": "@goease/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client --max-workers 1",
    "android": "expo run:android --no-bundler",
    "ios": "expo run:ios --no-bundler",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test test/*.test.ts",
    "check:expo": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist/android --max-workers 1",
    "export:ios": "expo export --platform ios --output-dir dist/ios --max-workers 1",
    "build": "pnpm export:android && pnpm export:ios"
  },
  "dependencies": {
    "@goease/contracts": "workspace:*",
    "expo": "57.0.27",
    "expo-dev-client": "57.0.19",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
