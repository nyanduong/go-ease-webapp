# Public build-time configuration only; never place server credentials here.
# Android emulator aliases the Windows host loopback with 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api
GOEASE_APP_VARIANT=development
# Public IDs only. Leave unset until the owner supplies real OAuth clients/test users.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Preview: GOEASE_APP_VARIANT=preview and a real HTTPS staging API URL.
