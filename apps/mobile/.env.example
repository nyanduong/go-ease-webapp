# Public URL only, not a secret. Use the API computer's LAN IPv4 on a phone.
# No trailing slash, path, query or credentials. Metro tunnel does not tunnel API.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# HTTPS demo #73: use the current trycloudflare HTTPS origin here; restart Metro.
# Session code is entered only at runtime in the dev HTTPS check, never EXPO_PUBLIC_*.
