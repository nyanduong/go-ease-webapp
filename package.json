{
  "name": "go-ease",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev:mobile": "pnpm build:packages && pnpm --filter @goease/mobile start",
    "dev:mobile:tunnel": "pnpm build:packages && pnpm --filter @goease/mobile start --tunnel",
    "dev:web": "pnpm build:packages && pnpm --filter @goease/mobile web",
    "check:docs": "python .github/scripts/check-docs.py",
    "check:expo": "pnpm --filter @goease/mobile exec expo install --check",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm build:packages && pnpm --filter @goease/mobile build",
    "build:packages": "pnpm --filter @goease/contracts build && pnpm --filter @goease/catalog --filter @goease/trip-storage build"
  }
}
