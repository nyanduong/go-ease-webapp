{
  "name": "go-ease",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev:mobile": "pnpm --filter @goease/catalog... build && pnpm --filter @goease/mobile start",
    "dev:mobile:tunnel": "pnpm --filter @goease/catalog... build && pnpm --filter @goease/mobile start --tunnel",
    "dev:web": "pnpm --filter @goease/catalog... build && pnpm --filter @goease/mobile web",
    "check:docs": "python .github/scripts/check-docs.py",
    "check:expo": "pnpm --filter @goease/mobile exec expo install --check",
    "typecheck": "pnpm --filter @goease/catalog... build && pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @goease/catalog... build && pnpm --filter @goease/mobile build"
  }
}
